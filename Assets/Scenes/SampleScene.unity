  m_Name: 
  m_EditorClassIdentifier: 
  tutorials:
  - TutorialText: 'Hey there kid. Welcome to Tamagotchi Elvis. I''m here to show
      you the ropes. '
    OnTutorialStart:
      m_PersistentCalls:
        m_Calls: []
    OnTutorialFinish:
      m_PersistentCalls:
        m_Calls: []
  - TutorialText: These here are your stats, you don't want them getting too low
      or too high.
    OnTutorialStart:
      m_PersistentCalls:
        m_Calls: []
    OnTutorialFinish:
      m_PersistentCalls:
        m_Calls: []
  - TutorialText: 'The TV fills your happiness. '
    OnTutorialStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1176910538}
          m_TargetAssemblyTypeName: CameraController, Assembly-CSharp
